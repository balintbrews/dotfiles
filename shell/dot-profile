# ~/.profile: executed by Bourne-compatible login shells.

if [ "$BASH" ]; then
  if [ -f ~/.bashrc ]; then
    . ~/.bashrc
  fi
fi

if tty -s; then
  mesg n
fi

# Rust toolchain installed through rustup for non-Bash login shells.
if [ -z "$BASH" ] && [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi
