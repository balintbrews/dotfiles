# Theme
theme = gruvbox-material-medium-dark

# Contrast
minimum-contrast = 1.3

# Font
font-family = "Lilex"
font-size = 13
font-thicken = true
adjust-cell-height = +15%

# Window
macos-titlebar-style = hidden
window-padding-x = 12
window-padding-y = 12
unfocused-split-opacity = 0.6
window-padding-balance = true
